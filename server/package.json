{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy --env dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "admin": "node scripts/admin.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env production"
  },
  "dependencies": {
    "hono": "^4.10.6",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.10",
    "@cloudflare/workers-types": "^4.20251120.0",
    "@vitest/coverage-istanbul": "^3.2.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.50.0"
  }
}
